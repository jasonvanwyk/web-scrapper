# Logging configuration
LOG_LEVEL=INFO

# Output configuration
OUTPUT_DIR=./output
CSV_FILENAME=product_data.csv
CSV_FILENAME_PATTERN={supplier}_{timestamp}.csv
INCLUDE_TIMESTAMP=True
CSV_ENCODING=utf-8
DOWNLOAD_IMAGES=False
IMAGE_DIR=./output/images

# Scraping configuration
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
REQUEST_DELAY=1.0
RESPECT_ROBOTS_TXT=True

# Browser automation configuration
BROWSER_TIMEOUT=30000
BROWSER_DELAY=2.0
HEADLESS=True
BROWSER_TYPE=chromium
STEALTH_MODE=True

# Notification configuration
NOTIFICATIONS_ENABLED=False
NOTIFY_ON_COMPLETION=True
NOTIFY_ON_ERROR=True
NOTIFY_SUMMARY=True

# Email notification configuration
EMAIL_NOTIFICATIONS_ENABLED=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@example.com
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# Slack notification configuration
SLACK_NOTIFICATIONS_ENABLED=False
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#scraper-notifications
SLACK_USERNAME=Scraper Bot
SLACK_ICON_EMOJI=:robot_face:

# Example supplier configuration (will be moved to a more structured format later)
# SUPPLIER_URL=https://example-supplier.com
# SUPPLIER_USERNAME=your_username
# SUPPLIER_PASSWORD=your_password
